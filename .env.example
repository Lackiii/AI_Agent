LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：截图多模态画面摘要（OpenAI 兼容 vision）。未设置 LLM_VISION_MODEL 时跳过 caption，不影响 OCR。
# LLM_VISION_API_KEY=
# LLM_VISION_BASE_URL=
# LLM_VISION_MODEL=

# 可选：把 Electron 用户数据（对话记忆、人设、提醒等 JSON）放到 E 盘；须为绝对路径
# Windows 示例：
# AI_AGENT_USER_DATA_PATH=E:\AI_Agent\userData
